# SPIC driver configuration
#

config SPIC_RTK_AMEBA_RXI312
	bool "RXI312 SPI controller driver for NAND"
	select SPI
	select SPI_REALTEK_RXI312
	default y
	help
	  This is the driver for the REALTEK RXI312 SPI controller for NAND.

choice
	prompt "RXI312 mode"
	depends on SPIC_RTK_AMEBA_RXI312

config SPI_RTS_QUADSPI_IRQ
	default y
	bool "RXI312 interrupt mode"

config SPI_RTS_QUADSPI_POLLING
	bool "RXI312 polling mode"

endchoice
